---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Seismograph from "../react/Seismograph";
import { site } from "../data/site";

// The CV button only appears if you put a file called cv.pdf in the public folder.
const hasCv = existsSync(join(process.cwd(), "public", "cv.pdf"));

const socials = [
  { label: "GitHub", href: site.github, external: true, icon: "github" },
  { label: "LinkedIn", href: site.linkedin, external: true, icon: "linkedin" },
  { label: "Email", href: `mailto:${site.email}`, external: false, icon: "email" },
].filter((s) => s.href);
---

<section id="home" class="relative isolate overflow-hidden pt-6 pb-8 md:pt-10 md:pb-10">
  <!-- Interactive Waveform Background (GPU Optimized) -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-52 md:h-72 opacity-75 overflow-hidden"
    aria-hidden="true"
  >
    <Seismograph client:load />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#070814] via-transparent to-[#070814]/80"></div>
  </div>

  <div class="mx-auto max-w-6xl px-6">
    <!-- Top Presentation Header Badge -->
    <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
      <span class="inline-flex items-center gap-2 rounded-full border border-purple-500/30 bg-purple-500/10 px-3.5 py-1 text-purple-300 backdrop-blur-md">
        <span class="h-1.5 w-1.5 rounded-full bg-purple-400 animate-pulse"></span>
        SLIDE 01 // PORTFOLIO OVERVIEW
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-emerald-300 backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-emerald-400 animate-ping"></span>
        Available for roles & internships
      </span>
    </div>

    <!-- 2-Column Hero Section -->
    <div class="mt-8 grid items-center gap-12 lg:grid-cols-12">
      <!-- Left Column: Bio & Actions -->
      <div class="lg:col-span-7">
        <p class="font-mono text-xs sm:text-sm tracking-widest text-cyan-400 uppercase">
          Mohamed Lafeer Umaima
        </p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl leading-[1.08]">
          <span class="text-white">Software </span>
          <span class="gradient-text-purple-blue">Developer </span>
          <span class="text-white">& </span>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-300">Designer</span>
        </h1>
        <p class="mt-6 max-w-xl text-base text-slate-300 sm:text-lg font-normal leading-relaxed">
          {site.tagline}
        </p>

        <!-- Call to Actions -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="#projects"
            class="gradient-btn group inline-flex items-center gap-2.5 rounded-xl px-6 py-3.5 text-sm sm:text-base font-semibold text-white transition-all"
          >
            <span>Explore Projects</span>
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>

          <a
            href="#contact"
            class="glass-panel glass-panel-hover inline-flex items-center gap-2 rounded-xl px-5 py-3.5 text-sm sm:text-base font-semibold text-white border-white/10 transition-all hover:border-purple-400/40"
          >
            <span>Get in Touch</span>
          </a>

          {hasCv && (
            <a
              href="/cv.pdf"
              class="glass-panel glass-panel-hover inline-flex items-center gap-2 rounded-xl px-5 py-3.5 text-sm sm:text-base font-semibold text-cyan-300 border-white/10 transition-all hover:border-cyan-400/40"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Download CV</span>
            </a>
          )}
        </div>

        <!-- Social Links -->
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span class="font-mono text-xs uppercase tracking-wider text-slate-400 mr-1">Connect:</span>
          {socials.map((s) => (
            <a
              href={s.href}
              class="glass-panel glass-panel-hover inline-flex items-center gap-2 rounded-lg px-3.5 py-1.5 text-xs font-medium text-slate-200 hover:text-white border-white/10"
              {...(s.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {s.label === "LinkedIn" && (
                <svg class="h-3.5 w-3.5 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28Z" />
                </svg>
              )}
              {s.label === "GitHub" && (
                <svg class="h-3.5 w-3.5 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
              )}
              {s.label === "Email" && (
                <svg class="h-3.5 w-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              )}
              <span>{s.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Right Column: Umaima Developer & Designer Visual Showcase -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Decorative ambient background glow -->
          <div class="pointer-events-none absolute -inset-2 rounded-3xl bg-gradient-to-tr from-purple-600/30 via-indigo-500/20 to-cyan-400/30 opacity-70 blur-2xl"></div>

          <!-- Glass Frame Container -->
          <div class="glass-panel relative overflow-hidden rounded-3xl border border-white/15 p-3 shadow-2xl backdrop-blur-2xl transition-transform duration-300 hover:scale-[1.01]">
            <!-- Top Card Header Bar -->
            <div class="flex items-center justify-between px-3 py-2 border-b border-white/[0.08] mb-3">
              <div class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-rose-500/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-amber-500/80"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-500/80"></span>
              </div>
              <div class="flex items-center gap-1.5 font-mono text-[11px] text-purple-300">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-ping"></span>
                <span>Umaima // Creative Engineer</span>
              </div>
            </div>

            <!-- Visual Portrait / Workspace Illustration -->
            <div class="relative aspect-square overflow-hidden rounded-2xl border border-white/10 bg-[#0c0e24]">
              <img
                src="/umaima-hero.jpg"
                alt="Illustration of Mohamed Lafeer Umaima coding and designing at a futuristic workstation"
                width="600"
                height="600"
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                loading="eager"
              />

              <!-- Floating Tag Badges Overlay -->
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                <span class="rounded-full bg-[#070814]/80 px-2.5 py-1 font-mono text-[10px] font-semibold text-cyan-300 backdrop-blur-md border border-cyan-500/30 shadow-lg">
                  ⚡ Full-Stack Code
                </span>
                <span class="rounded-full bg-[#070814]/80 px-2.5 py-1 font-mono text-[10px] font-semibold text-purple-300 backdrop-blur-md border border-purple-500/30 shadow-lg">
                  🎨 UI & Graphic Design
                </span>
              </div>

              <!-- Bottom Glass Details Overlay -->
              <div class="absolute inset-x-3 bottom-3 rounded-xl border border-white/15 bg-[#070814]/85 p-3 backdrop-blur-xl shadow-xl">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-purple-500 to-cyan-400 text-xs font-bold text-white shadow-md">
                      U
                    </div>
                    <div>
                      <p class="text-xs font-bold text-white leading-none">Mohamed Lafeer Umaima</p>
                      <p class="font-mono text-[10px] text-slate-400 mt-0.5">Software Engineering & Design</p>
                    </div>
                  </div>
                  <span class="font-mono text-[10px] text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded-full">
                    Active
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Presentation Stats / Highlights Grid -->
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 pt-6 border-t border-white/[0.08]">
      <div class="glass-panel rounded-xl p-4">
        <p class="font-mono text-xs text-purple-400">// EXPERTISE</p>
        <p class="mt-1 text-base font-bold text-white">Full-Stack & Mobile</p>
        <p class="text-xs text-slate-400">React, Node, Kotlin, PHP</p>
      </div>
      <div class="glass-panel rounded-xl p-4">
        <p class="font-mono text-xs text-cyan-400">// AI CHALLENGE 2026</p>
        <p class="mt-1 text-base font-bold text-white">Seismic AI Prototype</p>
        <p class="text-xs text-slate-400">Audio Spectrogram / ML</p>
      </div>
      <div class="glass-panel rounded-xl p-4">
        <p class="font-mono text-xs text-purple-400">// CREATIVE DESIGN</p>
        <p class="mt-1 text-base font-bold text-white">Graphic Diploma</p>
        <p class="text-xs text-slate-400">Photoshop, Illustrator, InDesign</p>
      </div>
      <div class="glass-panel rounded-xl p-4">
        <p class="font-mono text-xs text-blue-400">// LOCATION</p>
        <p class="mt-1 text-base font-bold text-white">Sri Lanka</p>
        <p class="text-xs text-slate-400">Undergrad @ BIET</p>
      </div>
    </div>
  </div>
</section>
