---
import { site, navLinks } from "../data/site";
---

<footer class="relative border-t border-white/[0.08] bg-[#05060e] py-8">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 sm:flex-row sm:items-center sm:justify-between">
    <!-- Brand Info -->
    <div class="flex items-center gap-3">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-purple-500 to-blue-500 text-xs font-extrabold text-white">
        U
      </div>
      <div>
        <p class="text-sm font-bold text-white">{site.name}</p>
        <p class="font-mono text-xs text-slate-400">Software Developer & Graphic Designer</p>
      </div>
    </div>

    <!-- Nav Links -->
    <div class="flex flex-wrap items-center gap-6 text-xs text-slate-400">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-purple-300 transition-colors">
          {link.label}
        </a>
      ))}
      <a
        href="#home"
        class="inline-flex items-center gap-1 text-cyan-400 hover:text-cyan-300 transition-colors font-mono"
      >
        <span>Back to top</span>
        <span>↑</span>
      </a>
    </div>
  </div>

  <div class="mx-auto mt-6 max-w-6xl border-t border-white/[0.04] px-6 pt-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 font-mono">
    <p>© 2026 {site.name}. All rights reserved.</p>
    <p>Modern Tech Presentation Portfolio // Astro & Tailwind CSS</p>
  </div>
</footer>
