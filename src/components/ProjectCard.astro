---
import type { Project } from "../data/site";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const links = [
  { label: "View Source Code", href: project.github, isCode: true },
  { label: "Live Interactive Demo", href: project.demo, isCode: false },
].filter((l) => l.href);
---

<article
  class:list={[
    "glass-panel glass-panel-hover relative flex h-full flex-col justify-between rounded-2xl p-7 transition-all border-white/10 md:p-9 overflow-hidden group",
    project.featured && "lg:col-span-2 border-purple-500/30 shadow-[0_0_30px_-10px_rgba(139,92,246,0.15)]",
  ]}
>
  <!-- Ambient subtle inner glow for featured project -->
  {project.featured && (
    <div class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-purple-500/15 blur-3xl" aria-hidden="true"></div>
  )}

  <div>
    <!-- Top Metadata Header -->
    <header class="flex flex-wrap items-center justify-between gap-3">
      <div class="inline-flex items-center gap-2 rounded-full border border-purple-500/30 bg-purple-500/10 px-3 py-1 text-xs font-medium text-purple-300 backdrop-blur-md">
        <span class="h-1.5 w-1.5 rounded-full bg-purple-400"></span>
        <span>{project.badge}</span>
      </div>

      {project.featured && (
        <span class="font-mono text-[11px] uppercase tracking-wider text-cyan-400 flex items-center gap-1.5 bg-cyan-950/40 border border-cyan-800/40 px-2.5 py-0.5 rounded-full">
          <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-ping"></span>
          Buildathon Prototype
        </span>
      )}
    </header>

    <!-- Project Image if present -->
    {project.image && (
      <div class="mt-6 overflow-hidden rounded-xl border border-white/10">
        <img
          src={project.image}
          alt={project.imageAlt ?? project.title}
          loading="lazy"
          class="aspect-video w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
        />
      </div>
    )}

    <!-- Project Title -->
    <h3 class="mt-5 text-2xl font-extrabold tracking-tight text-white group-hover:text-purple-200 transition-colors md:text-3xl">
      {project.title}
    </h3>

    <!-- Project Summary -->
    <p class="mt-3 text-base text-slate-300 leading-relaxed">
      {project.summary}
    </p>

    <!-- Architecture Steps (if featured/available) -->
    {project.steps && (
      <div class="mt-6 pt-6 border-t border-white/[0.08]">
        <h4 class="font-mono text-xs uppercase tracking-wider text-purple-300 mb-4 flex items-center gap-2">
          <span>// System Pipeline & Architecture</span>
        </h4>
        <div class="grid gap-3 sm:grid-cols-2">
          {project.steps.map((step, i) => (
            <div class="flex items-start gap-3 rounded-xl border border-white/[0.06] bg-white/[0.02] p-3.5 backdrop-blur-sm">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-purple-500/30 to-blue-500/30 font-mono text-xs font-bold text-cyan-300 border border-purple-500/30">
                0{i + 1}
              </span>
              <span class="text-xs text-slate-300 leading-relaxed">{step}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    {project.role && (
      <div class="mt-4 rounded-lg bg-white/[0.02] p-3 text-sm text-slate-300 border-l-2 border-cyan-400">
        <span class="font-semibold text-white">Role: </span>
        {project.role}
      </div>
    )}
  </div>

  <!-- Bottom: Tech Stack & Actions -->
  <div class="mt-8 pt-6 border-t border-white/[0.08]">
    <div class="flex flex-wrap items-center gap-2">
      {project.stack.map((tech) => (
        <span class="font-mono text-xs rounded-md bg-white/[0.04] border border-white/10 px-2.5 py-1 text-slate-300">
          {tech}
        </span>
      ))}
    </div>

    {links.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-3">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold transition-all",
              link.isCode
                ? "glass-panel glass-panel-hover text-white border-white/15 hover:border-purple-400/50"
                : "gradient-btn text-white"
            ]}
          >
            {link.isCode ? (
              <svg class="h-4 w-4 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            ) : (
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            )}
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</article>
