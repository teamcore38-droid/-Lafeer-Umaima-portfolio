---
import { services } from "../data/site";

const icons = [
  // Web development
  `<svg class="w-6 h-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
  // Mobile development
  `<svg class="w-6 h-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
  // AI Prototypes
  `<svg class="w-6 h-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  // Graphic Design
  `<svg class="w-6 h-6 text-pink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4 4 4 0 014-4h1v8H7zm0-10a4 4 0 014-4h4a4 4 0 014 4v2H7v-2z" /><circle cx="12" cy="7" r="1" fill="currentColor"/><circle cx="16" cy="7" r="1" fill="currentColor"/></svg>`
];
---

<section
  id="services"
  class="relative mx-auto max-w-6xl px-6 py-10 md:py-14"
  aria-labelledby="services-title"
>
  <!-- Presentation Chapter Tag -->
  <div class="flex items-center gap-2 font-mono text-xs text-purple-400">
    <span class="h-1.5 w-1.5 rounded-full bg-purple-400"></span>
    <span>SLIDE 02 // CORE CAPABILITIES</span>
  </div>

  <div class="mt-3 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div>
      <h2
        id="services-title"
        class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl"
      >
        What I <span class="gradient-text-purple-blue">Build & Design</span>
      </h2>
      <p class="mt-2.5 max-w-xl text-base text-slate-400">
        From resilient full-stack systems and Kotlin mobile apps to AI prototype pipelines and creative brand visuals.
      </p>
    </div>
    <div class="font-mono text-xs text-slate-400 hidden md:block">
      // 4 CORE DOMAINS
    </div>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {services.map((service, index) => (
      <div class="glass-panel glass-panel-hover group relative flex flex-col justify-between rounded-2xl p-7 border-white/10">
        <!-- Top accent glow indicator -->
        <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-purple-500/50 to-transparent opacity-0 transition-opacity group-hover:opacity-100"></div>

        <div>
          <!-- Header: Icon and Slide Index -->
          <div class="flex items-center justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/[0.05] border border-white/10 shadow-inner group-hover:scale-105 transition-transform" set:html={icons[index] || icons[0]}>
            </div>
            <span class="font-mono text-xs font-semibold text-slate-400 group-hover:text-purple-400 transition-colors">
              0{index + 1}
            </span>
          </div>

          <!-- Title -->
          <h3 class="mt-6 text-xl font-bold tracking-tight text-white group-hover:text-purple-200 transition-colors">
            {service.title}
          </h3>

          <!-- Items list -->
          <ul class="mt-4 space-y-2.5 text-sm text-slate-300">
            {service.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-400/80"></span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs font-mono text-slate-400">
          <span>Specialization</span>
          <span class="text-purple-400 group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </div>
    ))}
  </div>
</section>
