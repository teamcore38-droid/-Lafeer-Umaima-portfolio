---
import { site } from "../data/site";
---

<section
  id="contact"
  class="relative mx-auto max-w-6xl px-6 py-10 md:py-14"
  aria-labelledby="contact-title"
>
  <!-- Presentation Chapter Tag -->
  <div class="flex items-center gap-2 font-mono text-xs text-purple-400">
    <span class="h-1.5 w-1.5 rounded-full bg-purple-400"></span>
    <span>SLIDE 05 // GET IN TOUCH</span>
  </div>

  <div class="mt-3 border-b border-white/[0.08] pb-4">
    <h2
      id="contact-title"
      class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl"
    >
      Let's Build <span class="gradient-text-purple-blue">Together</span>
    </h2>
    <p class="mt-2.5 max-w-xl text-base text-slate-400">
      I'm seeking entry-level software engineering roles and internships. Whether you have a project to build, a team vacancy, or an AI idea to prototype, let's talk.
    </p>
  </div>

  <div class="mt-8 grid gap-8 lg:grid-cols-12">
    <!-- Left Column: Contact Methods & Channels -->
    <div class="space-y-4 lg:col-span-5">
      <!-- Direct Email Card -->
      <a
        href={`mailto:${site.email}`}
        class="glass-panel glass-panel-hover flex items-center gap-4 rounded-2xl p-5 border-white/10 group block"
      >
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-purple-500/20 text-purple-400 border border-purple-500/30 group-hover:scale-105 transition-transform">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-mono text-xs text-purple-400">// PRIMARY CONTACT</p>
          <p class="text-sm font-bold text-white group-hover:text-purple-200 transition-colors truncate">
            {site.email}
          </p>
          <p class="text-xs text-slate-400">Click to write an email</p>
        </div>
        <span class="text-slate-400 group-hover:text-purple-400 group-hover:translate-x-1 transition-all">→</span>
      </a>

      <!-- LinkedIn Card -->
      {site.linkedin && (
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="glass-panel glass-panel-hover flex items-center gap-4 rounded-2xl p-5 border-white/10 group block"
        >
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-500/20 text-blue-400 border border-blue-500/30 group-hover:scale-105 transition-transform">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28Z" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-mono text-xs text-blue-400">// PROFESSIONAL NETWORK</p>
            <p class="text-sm font-bold text-white group-hover:text-cyan-200 transition-colors">
              LinkedIn Profile
            </p>
            <p class="text-xs text-slate-400">Connect & message on LinkedIn</p>
          </div>
          <span class="text-slate-400 group-hover:text-blue-400 group-hover:translate-x-1 transition-all">↗</span>
        </a>
      )}

      <!-- GitHub Card (Optional) -->
      {site.github && (
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="glass-panel glass-panel-hover flex items-center gap-4 rounded-2xl p-5 border-white/10 group block"
        >
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-purple-500/20 text-purple-400 border border-purple-500/30 group-hover:scale-105 transition-transform">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-mono text-xs text-purple-400">// CODE REPOSITORIES</p>
            <p class="text-sm font-bold text-white group-hover:text-purple-200 transition-colors">
              GitHub Profile
            </p>
            <p class="text-xs text-slate-400">View projects & contributions</p>
          </div>
          <span class="text-slate-400 group-hover:text-purple-400 group-hover:translate-x-1 transition-all">↗</span>
        </a>
      )}

      <!-- Location Card -->
      <div class="glass-panel flex items-center gap-4 rounded-2xl p-5 border-white/10">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <div>
          <p class="font-mono text-xs text-emerald-400">// BASED IN</p>
          <p class="text-sm font-bold text-white">{site.location}</p>
          <p class="text-xs text-slate-400">Open to remote & on-site positions</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Contact Form -->
    <div class="lg:col-span-7">
      <div class="glass-panel rounded-2xl p-7 md:p-9 border-white/10 relative overflow-hidden">
        <h3 class="text-xl font-bold text-white mb-2">
          Send a Direct Message
        </h3>
        <p class="text-sm text-slate-300 mb-6">
          Fill out the form below or send an email directly to <a href={`mailto:${site.email}`} class="text-cyan-400 hover:underline">{site.email}</a>.
        </p>

        {site.formspreeId ? (
          <form
            action={`https://formspree.io/f/${site.formspreeId}`}
            method="POST"
            class="space-y-4"
          >
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="name" class="block font-mono text-xs font-medium text-slate-300 mb-1.5">
                  YOUR NAME
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="John Doe"
                  class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white placeholder-slate-400 backdrop-blur-md outline-none transition-all focus:border-purple-400 focus:bg-white/[0.07] focus:ring-2 focus:ring-purple-500/20"
                />
              </div>
              <div>
                <label for="email" class="block font-mono text-xs font-medium text-slate-300 mb-1.5">
                  YOUR EMAIL
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="john@example.com"
                  class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white placeholder-slate-400 backdrop-blur-md outline-none transition-all focus:border-cyan-400 focus:bg-white/[0.07] focus:ring-2 focus:ring-cyan-500/20"
                />
              </div>
            </div>

            <div>
              <label for="message" class="block font-mono text-xs font-medium text-slate-300 mb-1.5">
                YOUR MESSAGE
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Tell me about your project, opportunity, or timeline..."
                class="w-full rounded-xl border border-white/10 bg-white/[0.04] px-4 py-3 text-sm text-white placeholder-slate-400 backdrop-blur-md outline-none transition-all focus:border-purple-400 focus:bg-white/[0.07] focus:ring-2 focus:ring-purple-500/20"
              ></textarea>
            </div>

            <button
              type="submit"
              class="gradient-btn group inline-flex items-center gap-2.5 rounded-xl px-7 py-3 text-sm font-semibold text-white transition-all w-full sm:w-auto"
            >
              <span>Send Message</span>
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
        ) : (
          <div class="rounded-xl border border-white/10 bg-white/[0.02] p-6 text-center">
            <p class="text-sm text-slate-300">
              To send an instant message, reach out directly at:
            </p>
            <a
              href={`mailto:${site.email}`}
              class="gradient-btn mt-4 inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold text-white"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>{site.email}</span>
            </a>
            <p class="mt-4 font-mono text-xs text-slate-400">
              (You can also configure Formspree in <code class="text-purple-300">src/data/site.ts</code> anytime to enable the in-page form)
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
