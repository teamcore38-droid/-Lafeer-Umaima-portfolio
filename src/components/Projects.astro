---
import ProjectCard from "./ProjectCard.astro";
import { projects, site } from "../data/site";
---

<section
  id="projects"
  class="relative mx-auto max-w-6xl px-6 py-10 md:py-14"
  aria-labelledby="projects-title"
>
  <!-- Presentation Chapter Tag -->
  <div class="flex items-center gap-2 font-mono text-xs text-cyan-400">
    <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
    <span>SLIDE 03 // FEATURED PROJECTS</span>
  </div>

  <div class="mt-3 flex flex-wrap items-end justify-between gap-6 border-b border-white/[0.08] pb-4">
    <div>
      <h2
        id="projects-title"
        class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl md:text-5xl"
      >
        Engineered with <span class="gradient-text-purple-blue">Purpose</span>
      </h2>
      <p class="mt-2.5 max-w-xl text-base text-slate-400">
        Highlighting high-impact prototypes, Android applications, and full-stack software built with modern engineering workflows.
      </p>
    </div>

    {site.github && (
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="glass-panel glass-panel-hover inline-flex items-center gap-2.5 rounded-xl px-5 py-2.5 text-xs font-semibold text-slate-200 hover:text-white border-white/10 hover:border-purple-400/40 transition-all"
      >
        <svg class="h-4 w-4 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>Explore GitHub Profile</span>
        <span class="text-purple-400">↗</span>
      </a>
    )}
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>
